                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Task updated correctly', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.title).to.equal('Updated from Postman');",
                  "    pm.expect(json.completed).to.be.true;",
                  "    pm.expect(json.priority).to.equal('HIGH');",
                  "});"
                ]
              }
            }
