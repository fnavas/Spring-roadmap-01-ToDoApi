{
  "info": {
    "name": "TodoApi",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1"
    },
    {
      "key": "taskId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Tasks",
      "item": [
        {
          "name": "GET all tasks (default)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has content array', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.content).to.be.an('array');",
                  "    pm.expect(json.totalElements).to.be.above(0);",
                  "    pm.expect(json.totalPages).to.be.above(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/tasks",
              "host": ["{{baseUrl}}"],
              "path": ["tasks"]
            }
          }
        },
        {
          "name": "GET all tasks (page 0, size 5)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Page 0 with 5 elements', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.content.length).to.equal(5);",
                  "    pm.expect(json.number).to.equal(0);",
                  "    pm.expect(json.size).to.equal(5);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/tasks?page=0&size=5",
              "host": ["{{baseUrl}}"],
              "path": ["tasks"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "5" }
              ]
            }
          }
        },
        {
          "name": "GET all tasks (page 1, size 5)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Is page 1', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.number).to.equal(1);",
                  "    pm.expect(json.first).to.be.false;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/tasks?page=1&size=5",
              "host": ["{{baseUrl}}"],
              "path": ["tasks"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "size", "value": "5" }
              ]
            }
          }
        },
        {
          "name": "GET all tasks (sort by title ASC)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('First title is alphabetically first', () => {",
                  "    const json = pm.response.json();",
                  "    const titles = json.content.map(t => t.title);",
                  "    const sorted = [...titles].sort();",
                  "    pm.expect(titles).to.deep.equal(sorted);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/tasks?sortBy=title&sortDir=asc&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["tasks"],
              "query": [
                { "key": "sortBy", "value": "title" },
                { "key": "sortDir", "value": "asc" },
                { "key": "size", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "GET all tasks (sort by title DESC)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('First title is alphabetically last', () => {",
                  "    const json = pm.response.json();",
                  "    const titles = json.content.map(t => t.title);",
                  "    const sortedDesc = [...titles].sort().reverse();",
                  "    pm.expect(titles).to.deep.equal(sortedDesc);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/tasks?sortBy=title&sortDir=desc&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["tasks"],
              "query": [
                { "key": "sortBy", "value": "title" },
                { "key": "sortDir", "value": "desc" },
                { "key": "size", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "GET tasks filtered by title",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('All results contain title filter', () => {",
                  "    const json = pm.response.json();",
                  "    json.content.forEach(task => {",
                  "        pm.expect(task.title.toLowerCase()).to.include('clean');",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/tasks?title=clean",
              "host": ["{{baseUrl}}"],
              "path": ["tasks"],
              "query": [
                { "key": "title", "value": "clean" }
              ]
            }
          }
        },
        {
          "name": "GET tasks filtered by description",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('All results contain description filter', () => {",
                  "    const json = pm.response.json();",
                  "    json.content.forEach(task => {",
                  "        pm.expect(task.description.toLowerCase()).to.include('database');",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/tasks?description=database",
              "host": ["{{baseUrl}}"],
              "path": ["tasks"],
              "query": [
                { "key": "description", "value": "database" }
              ]
            }
          }
        },
        {
          "name": "GET tasks filtered by priority HIGH",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('All results have HIGH priority', () => {",
                  "    const json = pm.response.json();",
                  "    json.content.forEach(task => {",
                  "        pm.expect(task.priority).to.equal('HIGH');",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/tasks?priority=HIGH",
              "host": ["{{baseUrl}}"],
              "path": ["tasks"],
              "query": [
                { "key": "priority", "value": "HIGH" }
              ]
            }
          }
        },
        {
          "name": "GET tasks completed=true",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('All tasks are completed', () => {",
                  "    const json = pm.response.json();",
                  "    json.content.forEach(task => {",
                  "        pm.expect(task.completed).to.be.true;",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/tasks?completed=true&page=0&size=5",
              "host": ["{{baseUrl}}"],
              "path": ["tasks"],
              "query": [
                { "key": "completed", "value": "true" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "5" }
              ]
            }
          }
        },
        {
          "name": "GET tasks completed=false",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('All tasks are pending', () => {",
                  "    const json = pm.response.json();",
                  "    json.content.forEach(task => {",
                  "        pm.expect(task.completed).to.be.false;",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/tasks?completed=false&page=0&size=5",
              "host": ["{{baseUrl}}"],
              "path": ["tasks"],
              "query": [
                { "key": "completed", "value": "false" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "5" }
              ]
            }
          }
        },
        {
          "name": "GET task by ID (existing)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Task has expected fields', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('id');",
                  "    pm.expect(json).to.have.property('title');",
                  "    pm.expect(json).to.have.property('description');",
                  "    pm.expect(json).to.have.property('completed');",
                  "    pm.expect(json).to.have.property('priority');",
                  "    pm.expect(json).to.have.property('created');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/tasks/{{taskId}}",
              "host": ["{{baseUrl}}"],
              "path": ["tasks", "{{taskId}}"]
            }
          }
        },
        {
          "name": "GET task by ID (not found - 404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 404', () => pm.response.to.have.status(404));",
                  "pm.test('Error body has message', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('message');",
                  "    pm.expect(json).to.have.property('statusCode');",
                  "    pm.expect(json.statusCode).to.equal(404);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/tasks/999",
              "host": ["{{baseUrl}}"],
              "path": ["tasks", "999"]
            }
          }
        },
        {
          "name": "GET task by ID (invalid id - 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));",
                  "pm.test('Validation error returned', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.statusCode).to.equal(400);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/tasks/0",
              "host": ["{{baseUrl}}"],
              "path": ["tasks", "0"]
            }
          }
        },
        {
          "name": "POST create task (valid)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Location header present', () => {",
                  "    pm.expect(pm.response.headers.get('Location')).to.include('/tasks/');",
                  "});",
                  "pm.test('Task created with correct data', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.id).to.be.a('number');",
                  "    pm.expect(json.title).to.equal('New task from Postman');",
                  "    pm.expect(json.description).to.equal('Created to test the API');",
                  "    pm.expect(json.completed).to.be.false;",
                  "    pm.expect(json.priority).to.equal('MEDIUM');",
                  "});",
                  "const id = pm.response.json().id;",
                  "pm.collectionVariables.set('taskId', id);",
                  "console.log('Saved taskId:', id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"New task from Postman\",\n  \"description\": \"Created to test the API\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tasks",
              "host": ["{{baseUrl}}"],
              "path": ["tasks"]
            }
          }
        },
        {
          "name": "POST create task (with priority and dueDate)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Priority and dueDate persisted', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.priority).to.equal('HIGH');",
                  "    pm.expect(json.dueDate).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Urgent task\",\n  \"description\": \"High priority with deadline\",\n  \"priority\": \"HIGH\",\n  \"dueDate\": \"2027-12-31\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tasks",
              "host": ["{{baseUrl}}"],
              "path": ["tasks"]
            }
          }
        },
